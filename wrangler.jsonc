{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ping",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-19",
	// Custom Domain for the API. DNS for sillyapps.co is attached in Cloudflare separately.
	// Wrangler disables workers.dev when routes are set unless this stays true.
	"workers_dev": true,
	"routes": [
		{
			"pattern": "api-ping.sillyapps.co",
			"custom_domain": true,
		},
	],
	"observability": {
		"enabled": true,
		"logs": { "enabled": true, "head_sampling_rate": 1 },
		"traces": { "enabled": true, "head_sampling_rate": 1 },
	},
	"vars": {
		"APNS_BUNDLE_ID": "co.sillyapps.ping",
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ping",
			"database_id": "480c8082-276a-4c73-8c37-0ec915714dbf", // replace after `npx wrangler d1 create ping`
			"migrations_dir": "migrations",
		},
	],
}
